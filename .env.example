# ── AI Backend ─────────────────────────────────────────────────────────────
# Choose "claude" or "ollama"
AI_BACKEND=ollama

# ── Claude (Anthropic) Settings ─────────────────────────────────────────────
# Required when AI_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model overrides (optional — defaults shown)
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001

# ── Ollama Settings ──────────────────────────────────────────────────────────
# Required when AI_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Embeddings Backend (when AI_BACKEND=claude) ──────────────────────────────
# "huggingface" = downloads all-MiniLM-L6-v2 locally (~80 MB, one-time)
# "ollama"      = use Ollama for embeddings even when LLM is Claude
EMBED_BACKEND=huggingface

# ── App Settings ──────────────────────────────────────────────────────────────
APP_TITLE=GCP PMLE Quizzer
MAX_FILE_SIZE_MB=20
